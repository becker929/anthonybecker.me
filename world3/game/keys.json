{
  "id": "anthonybecker.me:keys",
  "name": "keys",
  "world": "https://world2.anthonybecker.me",
  "state": { "done": 0 },
  "entities": [
    { "id": "key", "kind": "item", "name": "brass key", "cell": [4, 6], "pos": [-2.6, 0.7, -2.4] },
    { "id": "gate", "kind": "barrier", "cell": [6, 7], "door": "S" },
    { "id": "gate_w", "kind": "barrier", "cell": [5, 8], "door": "E" },
    { "id": "drone", "kind": "drone" }
  ],
  "rules": [
    { "id": "got-key", "when": { "use": "key" }, "once": true,
      "do": [ { "give": "key" }, { "sound": "pickup" }, { "drone": "seek:barrier" }, { "say": "A brass key." } ] },
    { "id": "unlock", "when": { "use": "gate" }, "if": [ { "has": "key" } ], "once": true,
      "do": [ { "lose": "key" }, { "open": "gate" }, { "sound": "open" }, { "say": "The key turns." } ],
      "else": [ { "say": "Locked." } ] },
    { "id": "unlock-w", "when": { "use": "gate_w" }, "if": [ { "has": "key" } ], "once": true,
      "do": [ { "lose": "key" }, { "open": "gate_w" }, { "sound": "open" }, { "say": "The key turns." } ],
      "else": [ { "say": "Locked." } ] },
    { "id": "arrive", "when": { "enter": { "cell": [6, 8] } }, "once": true,
      "do": [ { "set": ["done", 1] }, { "drone": "follow" }, { "say": "The capybara was waiting for you." } ] }
  ]
}
