# Everything here is repo furniture, not site content. Without these lines
# wrangler walks the whole directory and serves them: .git objects, agent
# config, and build scratch all become fetchable URLs.
.git
.gitignore
.claude/
.wrangler/
node_modules/
wrangler.toml
/README.md
/src/
/d1/
/e2e/
# Lets Node tests import skrng/*.js as ES modules; not site content.
/skrng/package.json
# Source for the built apps under /apps/; only the built output is site content.
/apps/_src/
# Source for demos that need a build. The Bevy arcade deploys from here as its own Worker (arcade.anthonybecker.me).
/demos/_src/
# Source for the video library's pipeline (videos/_src); only the index page is site content.
/videos/_src/
